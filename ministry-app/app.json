{
  "expo": {
    "name": "JSCI Ministry",
    "slug": "jsci-ministry",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "jsciministry",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jsci.ministry",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "JSCI Ministry checks that you are at church when you mark your attendance."
      },
      "buildNumber": "4"
    },
    "android": {
      "package": "com.jsci.ministry",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#00000000"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#f8f9fa",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#1a1a2e"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "JSCI Ministry records your practice so your team can listen to it."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "JSCI Ministry uses Face ID to keep your account locked."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ]
          }
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-navigation-bar",
        {
          "visibility": "hidden",
          "behavior": "overlay-swipe"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "JSCI Ministry checks that you are at church when you mark your attendance.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3a63c924-4b33-4718-9a65-8c72571c02c0"
      }
    },
    "owner": "frank030901",
    "backgroundColor": "#f8f9fa",
    "web": {
      "output": "single",
      "bundler": "metro",
      "name": "JSCI Ministry",
      "shortName": "JSCI Ministry",
      "lang": "en",
      "themeColor": "#1a1a2e",
      "backgroundColor": "#1a1a2e",
      "favicon": "./public/icons/favicon.png"
    },
    "experiments": {
      "baseUrl": "/ministrysystem"
    }
  }
}
