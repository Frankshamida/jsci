{
  "id": "/rfid-chekin-display",
  "name": "JSCI Check-in Display",
  "short_name": "Check-in",
  "description": "The welcome screen at the door: every RFID card tapped turns the ID over to that delegate's name.",
  "start_url": "/rfid-chekin-display?app=1",
  "scope": "/rfid-chekin-display",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "landscape",
  "background_color": "#1b1405",
  "theme_color": "#1b1405",
  "categories": ["utilities", "productivity"],
  "icons": [
    { "src": "/app-icons/checkin-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/app-icons/checkin-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/app-icons/checkin-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
